# Copy to .env and fill in. Never commit .env.
PORT=8000
NODE_ENV=development

# Frontend origin (used for CORS and the OAuth redirect URI: <APP_BASE_URL>/callback)
APP_BASE_URL=http://localhost:5173

# Long random string used to sign the session cookie
SESSION_SECRET_KEY=

# "lax" when the API is served same-site (e.g. proxied via Netlify); defaults to "none" in production
COOKIE_SAMESITE=lax

# Postgres connection string (Neon / Supabase / Render Postgres / local).
# Used for both app data and sessions. Tables are created automatically.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Set to "false" for a local database without TLS
# DATABASE_SSL=false

# Quran Foundation OAuth2 ("prelive" | "production")
QF_ENV=prelive
QF_CLIENT_ID_DEV=
QF_CLIENT_SECRET_DEV=
QF_CLIENT_ID_PROD=
QF_CLIENT_SECRET_PROD=
QF_SCOPE=openid offline_access user
